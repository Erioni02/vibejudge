{
  "name": "motionsites-promo",
  "version": "1.0.0",
  "private": true,
  "description": "30s MotionSites promo video built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render:16x9": "remotion render Promo16x9 out/promo-16x9.mp4",
    "render:9x16": "remotion render Promo9x16 out/promo-9x16.mp4",
    "render:all": "npm run render:16x9 && npm run render:9x16",
    "voiceover": "tsx scripts/voiceover.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@remotion/cli": "4.0.520",
    "@remotion/google-fonts": "4.0.520",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
