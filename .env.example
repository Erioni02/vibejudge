# AI providers are tried in this order. If one fails, times out, or returns bad output, the next takes over.
AI_PROVIDER_ORDER=nvidia,ollama,opencode

# 2–3 keys per provider, comma-separated. Leave a provider empty to skip it.
NVIDIA_API_KEYS=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

OLLAMA_API_KEYS=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud

OPENCODE_API_KEYS=
# Pick a model ID from https://opencode.ai/zen/v1/models (the provider is skipped until this is set)
OPENCODE_MODEL=
