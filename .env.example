# Providers are tried in this order. Within a provider: model 1, then model 2, then model 3.
# Bad/rate-limited keys retry the same model on the next key; slow or broken models skip to the next model.
# If all of a provider's models fail, the next provider takes over.
AI_PROVIDER_ORDER=nvidia,ollama

# 2–3 keys per provider, comma-separated. Leave a provider's keys empty to skip it.
NVIDIA_API_KEYS=
NVIDIA_MODELS=nvidia/nemotron-3-super-120b-a12b,deepseek-ai/deepseek-v4.1-flash,z-ai/glm-5.3-flash

OLLAMA_API_KEYS=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODELS=gemma4:31b,gpt-oss:20b,nemotron-3-nano:30b


# ─── Private analytics dashboard (/admin-analytics) ─────────────────────────────
# Postgres connection string (Neon, Supabase, Vercel Postgres, …). Server-only.
# Without it the site works normally and analytics are simply not stored.
DATABASE_URL=

# The single administrator. Generate the hash and secret with: npm run admin:hash
# If any of these three is missing, /admin-analytics returns 404.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Raw event retention in days (minimum 30). Default 395 (13 months).
ANALYTICS_RETENTION_DAYS=395
