# Providers are tried in this order. Within a provider: model 1 (every key), then model 2, then model 3.
# If all of a provider's models fail, the next provider takes over.
AI_PROVIDER_ORDER=nvidia,ollama,opencode

# 2–3 keys per provider, comma-separated. Leave a provider's keys empty to skip it.
NVIDIA_API_KEYS=
NVIDIA_MODELS=deepseek-ai/deepseek-v4.1-flash,z-ai/glm-5.3-flash,nvidia/nemotron-3-super-120b-a12b

OLLAMA_API_KEYS=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODELS=gemma4:31b,gpt-oss:20b,nemotron-3-nano:30b

OPENCODE_API_KEYS=
OPENCODE_MODELS=nemotron-3.5-lightning-free,ling-3.1-flash-free,mimo-v2.6-flash-free
